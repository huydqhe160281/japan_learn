generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Model cho ký tự tiếng Nhật
model JapaneseCharacter {
  id        String       @id @default(cuid())
  character String       // Ký tự tiếng Nhật (ví dụ: あ, ア)
  romaji    String       // Cách đọc bằng romaji (ví dụ: a, ka)
  type      AlphabetType // Loại bảng chữ cái: hiragana hoặc katakana
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type])
  @@map("japanese_characters")
}

enum AlphabetType {
  hiragana
  katakana
}
